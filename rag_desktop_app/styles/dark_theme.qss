/* =========================================================
   GLOBAL FOUNDATION
   ========================================================= */

* {
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    color: #e6e6eb;
}

QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #0f1020,
        stop: 1 #15162a
    );
}

/* =========================================================
   SIDEBAR
   ========================================================= */

#sidebar {
    background-color: #0c0e1a;
    border-right: 1px solid rgba(255, 255, 255, 0.04);
}

/* Sidebar action buttons (rail) */
#sidebarAction {
    background: transparent;
    border: none;
    color: #8b5cf6;
    border-radius: 14px;
    padding: 10px;
}

#sidebarAction:hover {
    background-color: rgba(139, 92, 246, 0.18);
}

/* Sidebar action text (expanded only) */
#sidebarActionText {
    color: #e6e6eb;
    font-size: 13px;
    font-weight: 500;
}

/* Sidebar section label */
#sidebarSection {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    font-weight: 500;
}

/* Chat items */
#chatItem {
    background-color: rgba(255, 255, 255, 0.035);
    border-radius: 10px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

#chatItem:hover {
    background-color: rgba(139, 92, 246, 0.16);
}

#chatItem:checked {
    background-color: rgba(139, 92, 246, 0.28);
}

/* =========================================================
   SIDEBAR – CHAT ITEM DENSITY FIX (STEP 1–3)
   ========================================================= */

#chatItem {
    font-size: 12px;          /* slightly smaller to avoid clipping */
    padding: 6px 8px;         /* tighter horizontal padding */
    text-align: left;
}

/* Ensure text doesn't visually collide with delete icon */
#chatItem {
    padding-right: 6px;
}

/* Delete button in chat row */
QToolButton {
    border: none;
    padding: 0px;
    margin-left: 2px;
}

/* Subtle hover feedback for delete */
QToolButton:hover {
    background-color: rgba(255, 80, 80, 0.18);
    border-radius: 6px;
}


/* =========================================================
   CHAT HEADER (TOP BAR)
   ========================================================= */

#chatHeader {
    background-color: rgba(15, 16, 32, 0.92);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* Window control buttons */
#windowControl {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #e6e6eb;
}

#windowControl:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

#windowControl:pressed {
    background-color: rgba(255, 255, 255, 0.22);
}

/* Close button hover (danger hint) */
#windowControl:last-child:hover {
    background-color: rgba(220, 60, 60, 0.8);
}

/* =========================================================
   CHAT CANVAS
   ========================================================= */

#messagesArea {
    background-color: #101225;
    border: none;
}

/* User message bubble */
#userMessage {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #8b5cf6,
        stop: 1 #6366f1
    );
    color: #ffffff;
    border-radius: 18px;
    padding: 10px;
    margin: 4px 70px 8px 0px;
}

/* AI message bubble */
#aiMessage {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 18px;
    padding: 10px;
    margin: 4px 0px 8px 70px;
}

/* =========================================================
   SYSTEM / ERROR MESSAGE (API OFF, WARNINGS)
   ========================================================= */

#systemMessage {
    background-color: rgba(255, 180, 80, 0.14);
    color: #ffcf8a;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    max-width: 520px;
    line-height: 1.4;
}

/* =========================================================
   LOADING MESSAGE
   ========================================================= */

#loadingMessage {
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
}

/* =========================================================
   INPUT PILL
   ========================================================= */

#inputPill {
    background-color: rgba(255, 255, 255, 0.085);
    border: none;
    border-radius: 26px;
}

/* Focus highlight */
#inputPill[focused="true"] {
    background-color: rgba(139, 92, 246, 0.18);
}

/* Input field */
#pillField {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 15px;
    selection-background-color: rgba(139, 92, 246, 0.35);
}

/* Input icons */
#pillIcon {
    background: transparent;
    border: none;
    color: #8b5cf6;
    padding: 6px;
    border-radius: 18px;
}

#pillIcon:hover {
    background-color: rgba(139, 92, 246, 0.14);
}

#pillIcon:pressed {
    background-color: rgba(139, 92, 246, 0.25);
}

/* =========================================================
   SUGGESTION CARDS
   ========================================================= */

#suggestionCard {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 14px;
}

#suggestionCard:hover {
    background-color: rgba(139, 92, 246, 0.18);
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 5px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(139, 92, 246, 0.5);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
}

