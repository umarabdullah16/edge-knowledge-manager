/* =========================================================
   LOCKED VISUAL SYSTEM
   =========================================================
   Shell black (sidebar/top): #050507
   Chat canvas:               #0E0E11
   User bubble:               #2B2B35
   AI bubble:                 #07070A
   Accent (hot magenta):      #FF2D95
   Text primary:              #EAEAF0
   Text muted:                #9A9AA3
   Border soft:               #1C1C22
   ========================================================= */


/* =========================================================
   GLOBAL FOUNDATION
   ========================================================= */

* {
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    color: #EAEAF0;
}

QMainWindow {
    background-color: #0E0E11;
}


/* =========================================================
   PITCH-BLACK SHELL (SIDEBAR + TOP BAR)
   ========================================================= */

#sidebar {
    background-color: #050507;
    border-right: 1px solid #1C1C22;
}

#chatHeader {
    background-color: #050507;
    border-bottom: 1px solid #1C1C22;
}


/* =========================================================
   SIDEBAR CONTROLS
   ========================================================= */

#sidebarAction {
    background: transparent;
    border: none;
    color: #FF2D95;
    border-radius: 12px;
    padding: 10px;
}

#sidebarAction:hover {
    background-color: rgba(255, 45, 149, 0.14);
}

#sidebarActionText {
    font-size: 13px;
    font-weight: 500;
}

#sidebarSection {
    color: #9A9AA3;
    font-size: 12px;
    font-weight: 500;
}


/* =========================================================
   CHAT ITEMS (SIDEBAR)
   ========================================================= */

#chatItem {
    background-color: transparent;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}

#chatItem:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Active chat — subtle magenta presence */
#chatItem:checked {
    background-color: rgba(255, 45, 149, 0.18);
}


/* Delete button */
QToolButton {
    border: none;
    padding: 0px;
    margin-left: 4px;
}

QToolButton:hover {
    background-color: rgba(255, 80, 80, 0.18);
    border-radius: 6px;
}


/* =========================================================
   WINDOW CONTROLS
   ========================================================= */

#windowControl {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#windowControl:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

#windowControl:pressed {
    background-color: rgba(255, 255, 255, 0.18);
}

#windowControl:last-child:hover {
    background-color: rgba(220, 60, 60, 0.9);
}


/* =========================================================
   CHAT CANVAS (DEPTH FIXED)
   ========================================================= */

#messagesArea {
    background-color: #0E0E11;
    border: 1px solid #1C1C22;   /* inner frame for depth */
    padding: 6px;               /* stage edge */
}


/* =========================================================
   MESSAGE BUBBLES
   ========================================================= */

#userMessage {
    background-color: #2B2B35;
    border-radius: 16px;
    padding: 10px 14px;
    margin: 4px 70px 8px 0px;
}

#aiMessage {
    background-color: #07070A;
    border-radius: 16px;
    padding: 10px 14px;
    margin: 4px 0px 8px 70px;
}


/* =========================================================
   SYSTEM / STATUS MESSAGE
   ========================================================= */

#systemMessage {
    background-color: rgba(255, 45, 149, 0.12);
    color: #FFD1E8;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    max-width: 520px;
}


/* =========================================================
   LOADING MESSAGE
   ========================================================= */

#loadingMessage {
    color: #9A9AA3;
    font-style: italic;
}


/* =========================================================
   INPUT PILL (REFERENCE INTERACTION)
   ========================================================= */

#inputPill {
    background-color: #07070A;
    border: 1px solid #1C1C22;
    border-radius: 26px;
}

#inputPill[focused="true"] {
    border: 1px solid #FF2D95;
}

#pillField {
    background: transparent;
    border: none;
    font-size: 15px;
    selection-background-color: rgba(255, 45, 149, 0.35);
}

#pillIcon {
    background: transparent;
    border: none;
    color: #FF2D95;
    padding: 6px;
    border-radius: 18px;
}

#pillIcon:hover {
    background-color: rgba(255, 45, 149, 0.18);
}

#pillIcon:pressed {
    background-color: rgba(255, 45, 149, 0.32);
}


/* =========================================================
   SUGGESTION CARDS (GLOW, NOT COLOR)
   ========================================================= */

#suggestionCard {
    background-color: #07070A;
    border-radius: 14px;
    border: 1px solid #1C1C22;
}

#suggestionCard:hover {
    border: 1px solid #FF2D95;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 6px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 45, 149, 0.55);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
}
