/* ===============================
   Global styles
   =============================== */

* {
    font-family: "Segoe UI", "Arial", sans-serif;
}

QMainWindow {
    background-color: #1a1a1a;
    color: #ffffff;
}

/* ===============================
   Sidebar
   =============================== */

#sidebar {
    background-color: #242424;
    border-right: 1px solid #3a3a3a;
}

#newChatButton {
    background-color: #bb86fc;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 12px 16px;
}

#newChatButton:hover {
    background-color: #c79bff;
}

#conversationsList {
    background-color: transparent;
    border: none;
}

/* ===============================
   Chat header
   =============================== */

#chatHeader {
    background-color: #242424;
    border-bottom: 1px solid #3a3a3a;
}

/* ===============================
   Messages
   =============================== */

#messagesArea {
    background-color: #1a1a1a;
    border: none;
}

#userMessage {
    background-color: #bb86fc;
    border-radius: 16px;
    margin: 3px 80px 8px 0px;
}

#aiMessage {
    background-color: #2d2d2d;
    border-radius: 16px;
    margin: 3px 0px 8px 80px;
    border: 1px solid #3a3a3a;
}

/* ===============================
   Input area
   =============================== */

#inputArea {
    background-color: #242424;
    border-top: 1px solid #3a3a3a;
}

#inputField {
    background-color: #1a1a1a;
    border: 2px solid #3a3a3a;
    border-radius: 12px;
    padding: 12px 16px;
    color: #ffffff;
}

#inputField:focus {
    border-color: #bb86fc;
}

#sendButton {
    background-color: #bb86fc;
    color: white;
    border-radius: 10px;
    font-weight: 600;
}

#sendButton:disabled {
    background-color: #4a4a4a;
    color: #888888;
}

/* ===============================
   Loading animation
   =============================== */

#loadingContainer {
    background-color: rgba(36, 36, 36, 0.9);
    border: 1px solid rgba(187, 134, 252, 0.2);
    border-radius: 12px;
}
